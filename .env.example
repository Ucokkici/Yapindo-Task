PORT=5000

# Konfigurasi Database (Ganti sesuai setelan MySQL lokal Anda)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3307/yapindo_db"

# Keamanan Token JWT
JWT_SECRET=your_jwt_secret_here

# Kunci API Google Gemini (Dapatkan dari Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Konfigurasi Redis Caching (Nilai standar bawaan aplikasi)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379